# Build-time public settings. PUBLIC_* values are exposed to browser code.
PUBLIC_SITE_URL=https://shane-perez.netlify.app
PUBLIC_SITE_READY=false
PUBLIC_SHOW_DRAFT_CONTENT=false
PUBLIC_PROFILE_CLAIMS_VERIFIED=false

# Consent-gated tracking. Leave blank until approved IDs are available.
PUBLIC_GOOGLE_ANALYTICS_ID=
PUBLIC_META_PIXEL_ID=

# Cloudflare Turnstile. The site key is public; the secret is server-only.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=shane-perez.netlify.app,localhost
TURNSTILE_EXPECTED_ACTION=website_form

# Resend notifications. All values below are server-only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
RECRUITMENT_NOTIFICATION_EMAILS=
CONSULTATION_NOTIFICATION_EMAILS=
CONTACT_NOTIFICATION_EMAILS=

# Private résumé storage. The selected deployment provider is AWS S3.
# Set to aws-s3 or cloudflare-r2. Only one provider is active per environment.
RESUME_STORAGE_PROVIDER=aws-s3
RESUME_STORAGE_BUCKET=
RESUME_STORAGE_REGION=ap-southeast-1
RESUME_STORAGE_ENDPOINT=
RESUME_STORAGE_ACCESS_KEY_ID=
RESUME_STORAGE_SECRET_ACCESS_KEY=
RESUME_SIGNED_URL_EXPIRATION_SECONDS=86400
RESUME_RETENTION_DAYS=30

# Comma-separated exact origins allowed to call public form endpoints.
ALLOWED_ORIGINS=https://shane-perez.netlify.app,http://localhost:8888,http://localhost:4321
