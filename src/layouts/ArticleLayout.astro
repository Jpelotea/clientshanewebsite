---
import BaseLayout from './BaseLayout.astro'; import Breadcrumbs from '@/components/global/Breadcrumbs.astro'; interface Props{title:string;description:string;category:string;publishDate:Date;updatedDate?:Date;author:string;status:string;} const{title,description,category,publishDate,updatedDate,author,status}=Astro.props;const canonical=new URL(Astro.url.pathname,Astro.site||Astro.url.origin).toString();const articleSchema=status==='approved'?{'@context':'https://schema.org','@type':'Article',headline:title,description,datePublished:publishDate.toISOString(),dateModified:(updatedDate||publishDate).toISOString(),author:{'@type':'Person',name:author},mainEntityOfPage:canonical}:undefined;
---
<BaseLayout title={title} description={description} type="article" jsonLd={articleSchema} noindex={status!=='approved'}><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Insights',href:'/insights/'},{label:title}]}/><header class="article-header"><div class="container prose"><span class="badge">{category}</span><h1>{title}</h1><p class="lead">{description}</p><p class="article-meta">By {author} · {publishDate.toLocaleDateString('en-PH',{year:'numeric',month:'long',day:'numeric'})}</p>{status!=='approved'&&<div class="notice notice--warning"><strong>Structured draft:</strong> factual sections require Shane’s interview responses, verification, and approval before publication.</div>}</div></header><article class="article-body container prose"><slot /></article></BaseLayout>
