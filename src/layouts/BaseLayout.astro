---
import '@/styles/global.css';
import Header from '@/components/navigation/Header.astro';
import Footer from '@/components/navigation/Footer.astro';
import CookieConsent from '@/components/global/CookieConsent.astro';
import SEO from '@/components/seo/SEO.astro';
import { site } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const props = Astro.props;
const siteReady = import.meta.env.PUBLIC_SITE_READY === 'true';
const claimsVerified = import.meta.env.PUBLIC_PROFILE_CLAIMS_VERIFIED === 'true';
const effectiveNoindex = !siteReady || props.noindex === true;
const personSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site || Astro.url.origin).toString(),
};

if (claimsVerified) {
  personSchema.alternateName = site.fullName;
  personSchema.description = site.description;
  personSchema.jobTitle = 'Branch Head, Leadership Mentor, and Financial-Services Professional';
}

const suppliedSchemas = props.jsonLd ? (Array.isArray(props.jsonLd) ? props.jsonLd : [props.jsonLd]) : [];
const schemas = [personSchema, ...suppliedSchemas];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b3a2b" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <SEO {...props} noindex={effectiveNoindex} jsonLd={schemas} />
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-skip-link>Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <CookieConsent />
    <script>
      const mainContent = document.getElementById('main-content');
      const skipLink = document.querySelector('[data-skip-link]');
      const focusMainContent = () => {
        if (mainContent instanceof HTMLElement) mainContent.focus({ preventScroll: true });
      };

      skipLink?.addEventListener('click', () => requestAnimationFrame(focusMainContent));
      window.addEventListener('hashchange', () => {
        if (window.location.hash === '#main-content') focusMainContent();
      });
      if (window.location.hash === '#main-content') requestAnimationFrame(focusMainContent);

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest<HTMLElement>('[data-track]');
        if (!link) return;
        const name = link.dataset.track;
        if (name && typeof window.gtag === 'function') window.gtag('event', name);
        if (name && typeof window.fbq === 'function') window.fbq('trackCustom', name);
      });
    </script>
  </body>
</html>
