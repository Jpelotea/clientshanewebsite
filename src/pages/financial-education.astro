---
import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/sections/PageHero.astro';import CTASection from '@/components/sections/CTASection.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';
---
<BaseLayout title="Financial Education" description="Explore Shane Perez’s financial-education advocacy and approved educational resources for professionals, families, business owners, and OFWs."><PageHero eyebrow="Financial Education" title="Clear information can support better financial conversations." description="This section will organize accessible educational content while keeping product, advice, and company-specific statements within the required review process." breadcrumbs={[{label:'Home',href:'/'},{label:'Financial Education'}]}/><section class="section"><div class="container grid grid--2" style="align-items:start"><div class="prose"><h2>Education before promotion.</h2><p>The initial content direction focuses on practical financial habits, preparedness, protection concepts, savings, planning, and questions people can discuss with an appropriately authorized professional.</p><p>Content should be understandable, balanced, and careful not to present general educational material as individualized financial advice.</p></div><DisclosureNotice type="warning" title="Financial-content review"><p>All content involving insurance, products, financial advice, performance, returns, benefits, or company materials requires Shane’s review and, where applicable, compliance approval.</p></DisclosureNotice></div></section><section class="section section--muted"><div class="container grid grid--3"><article class="card"><h3>Financial Preparedness</h3><p>Emergency planning, financial priorities, risk awareness, and responsible next steps.</p></article><article class="card"><h3>Protection and Planning</h3><p>General educational concepts that help readers prepare questions for a professional consultation.</p></article><article class="card"><h3>Professional and Family Goals</h3><p>Content for working professionals, business owners, families, OFWs, and OFW households.</p></article></div></section><section class="section"><div class="container prose"><h2>Planned educational resources</h2><ul><li>[APPROVED FINANCIAL READINESS CHECKLIST — FUTURE RESOURCE]</li><li>[APPROVED FINANCIAL EDUCATION ARTICLES]</li><li>[FREQUENTLY ASKED QUESTIONS REVIEWED FOR COMPLIANCE]</li><li>[CONSULTATION SCOPE AND DISCLOSURE LANGUAGE]</li></ul><p>The Insights section can contain both financial education and leadership content under clear categories.</p><p><a class="button button--secondary" href="/insights/">Explore Insights</a></p></div></section><CTASection title="Request a professional conversation." description="Submit a consultation request with your preferred dates. The schedule will be reviewed and confirmed manually." primaryLabel="Request a Consultation" primaryHref="/book-consultation/" secondaryLabel="Contact Shane’s Team" secondaryHref="/contact/"/></BaseLayout>
