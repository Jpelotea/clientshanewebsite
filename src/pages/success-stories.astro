---
import {getCollection} from 'astro:content';import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/sections/PageHero.astro';import CTASection from '@/components/sections/CTASection.astro';import TestimonialCard from '@/components/cards/TestimonialCard.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';import{isVisible}from '@/lib/content';const testimonials=(await getCollection('testimonials')).filter(isVisible);const order=['Financial Advisor','Leadership','Team Success','Client'];
---
<BaseLayout title="Success Stories and Testimonials" description="Review approved Financial Advisor, leadership, team, and client stories connected to Shane Perez’s professional community."><PageHero eyebrow="Success Stories" title="Real experiences, shared with permission." description="This section is designed to present credible experiences without exaggeration, invented outcomes, or unapproved personal information." breadcrumbs={[{label:'Home',href:'/'},{label:'Success Stories and Testimonials'}]}/><section class="section"><div class="container"><DisclosureNotice type="warning" title="Permission and accuracy"><p>Every testimonial, name, role, image, client story, and result requires written permission, factual verification, and final approval before publication.</p></DisclosureNotice>{order.map(type=>{const entries=testimonials.filter(item=>item.data.type===type);return entries.length?<section style="margin-top:3rem"><h2>{type==='Team Success'?'Team Success Stories':`${type} Testimonials`}</h2><div class="grid grid--3">{entries.map(({data})=><TestimonialCard {...data} approved={data.status==='approved'&&data.permissionConfirmed}/>)}</div></section>:null;})}{!testimonials.length&&<div style="margin-top:2rem" class="card"><h2>Planned launch content</h2><ul><li>2 Financial Advisor testimonials</li><li>1 Unit Head or Senior Unit Head testimonial</li><li>2 team success stories</li><li>2 approved client testimonials</li></ul><p>[ALL TESTIMONIAL COPY, NAMES, ROLES, PHOTOS, AND PERMISSIONS ARE PENDING]</p></div>}</div></section><CTASection title="Explore the opportunity behind the stories." description="Review the candidate profiles, responsible expectations, and recruitment process before deciding whether to apply." primaryLabel="Explore Career Opportunities" primaryHref="/join-my-team/" secondaryLabel="Meet the Leadership Community" secondaryHref="/team-leadership-community/"/></BaseLayout>
