---
import{getCollection}from 'astro:content';import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/sections/PageHero.astro';import CTASection from '@/components/sections/CTASection.astro';import LeaderCard from '@/components/cards/LeaderCard.astro';import MediaPlaceholder from '@/components/global/MediaPlaceholder.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';import{isVisible}from '@/lib/content';const leaders=(await getCollection('leaders')).filter(isVisible);
---
<BaseLayout title="Team and Leadership Community" description="Discover the mentorship, professional development, team culture, and approved leadership stories connected to Shane Perez’s community."><PageHero eyebrow="Leadership Community" title="Growth is stronger when it is shared." description="This page will show how mentorship, standards, recognition, professional development, and community support contribute to leadership growth." breadcrumbs={[{label:'Home',href:'/'},{label:'Team and Leadership Community'}]}/><section class="section"><div class="container grid grid--2" style="align-items:center"><MediaPlaceholder label="[APPROVED TEAM COMMUNITY PHOTO REQUIRED]" height="25rem"/><div class="prose"><h2>A community designed to develop people.</h2><p>The page should reflect a culture of learning, accountability, support, recognition, and leadership development—not only production or recruitment.</p><p>[SHANE’S APPROVED DESCRIPTION OF TEAM CULTURE REQUIRED]</p></div></div></section><section class="section section--muted"><div class="container"><h2>Featured leaders</h2>{leaders.length?<div class="grid grid--2">{leaders.map(({data})=><LeaderCard {...data} approved={data.status==='approved'}/>)}</div>:<DisclosureNotice title="Two initial profiles are planned"><p>Leader names, verified roles, photographs, stories, achievements, and publication permission are still required.</p></DisclosureNotice>}</div></section><section class="section"><div class="container grid grid--3"><article class="card"><h3>Mentorship</h3><p>Guidance that helps professionals improve judgment, communication, discipline, and confidence.</p></article><article class="card"><h3>Recognition</h3><p>Celebrating meaningful milestones while ensuring every public claim and credential is accurate and approved.</p></article><article class="card"><h3>Leadership Development</h3><p>Providing opportunities to learn how to coach, support teams, and develop other people responsibly.</p></article></div></section><CTASection title="See how leadership can grow from a career opportunity." description="Review the candidate profiles and responsible recruitment pathway before deciding whether to apply." primaryLabel="Explore Career Opportunities" primaryHref="/join-my-team/" secondaryLabel="View Success Stories" secondaryHref="/success-stories/"/></BaseLayout>
