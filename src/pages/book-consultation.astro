---
import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/sections/PageHero.astro';import ConsultationForm from '@/components/forms/ConsultationForm.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';import faqData from '@/data/faqs.json';const{consultationFaqs}=faqData;
---
<BaseLayout title="Book a Consultation" description="Request a financial, career, or leadership discussion with Shane Perez. Requested dates are reviewed and confirmed manually."><PageHero eyebrow="Start a Conversation" title="Request a consultation." description="Choose a discussion type and provide preferred dates. Your submission is a request—not an automatically confirmed appointment." breadcrumbs={[{label:'Home',href:'/'},{label:'Book a Consultation'}]}/><section class="section"><div class="container"><div class="grid grid--3"><article class="card card--accent"><h2>Financial Consultation</h2><p><strong>Suggested duration: 30 minutes</strong></p><p>For visitors who want to request a professional discussion related to financial planning or financial education. Final scope and regulated content remain subject to approval.</p></article><article class="card card--accent"><h2>Career Opportunity Discussion</h2><p><strong>Suggested duration: 30 minutes</strong></p><p>For professionals who want to understand the Financial Advisor career before deciding whether to apply.</p></article><article class="card card--accent"><h2>Leadership Opportunity Discussion</h2><p><strong>Suggested duration: 45 minutes</strong></p><p>For existing Financial Advisors or experienced professionals interested in mentorship, leadership, and organization building.</p></article></div><div style="margin-top:2rem"><DisclosureNotice title="Manual confirmation"><p>Shane or an authorized representative will review the request. Calendar invitations, meeting links, and final schedules are sent manually after approval.</p></DisclosureNotice></div><div style="margin-top:3rem"><ConsultationForm/></div></div></section><section class="section section--muted"><div class="container prose"><h2>Frequently asked questions</h2>{consultationFaqs.map(item=><details class="card card--flat" style="margin-bottom:1rem"><summary><strong>{item.question}</strong></summary><p style="margin-top:1rem">{item.answer}</p></details>)}</div></section></BaseLayout>
