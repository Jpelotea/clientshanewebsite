---
import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/sections/PageHero.astro';import ContactForm from '@/components/forms/ContactForm.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';import{site}from '@/data/site';
---
<BaseLayout title="Contact" description="Contact Shane Perez or an authorized representative through the general inquiry form and approved public channels."><PageHero eyebrow="Contact" title="Send an inquiry." description="Use the form for general messages. Career applications and consultation requests have separate, purpose-specific pages." breadcrumbs={[{label:'Home',href:'/'},{label:'Contact'}]}/><section class="section"><div class="container grid grid--2" style="align-items:start"><div><h2>Public contact details</h2><DisclosureNotice type="warning" title="Contact information pending"><p>Do not publish the following placeholders until Shane confirms the exact public contact details and branch address.</p></DisclosureNotice><dl><dt><strong>Email</strong></dt><dd>{site.contact.email}</dd><dt><strong>Mobile</strong></dt><dd>{site.contact.mobile}</dd><dt><strong>Messenger</strong></dt><dd>{site.contact.messenger}</dd><dt><strong>Facebook</strong></dt><dd>{site.contact.facebook}</dd><dt><strong>LinkedIn</strong></dt><dd>{site.contact.linkedin}</dd><dt><strong>Branch / office location</strong></dt><dd>{site.contact.address}</dd></dl><p class="help">[APPROVED RESPONSE-EXPECTATION MESSAGE REQUIRED]</p></div><div class="card"><h2>Choose the correct path</h2><ul><li><a href="/recruitment-application/">Recruitment Application</a> — for candidates ready to submit complete information and a résumé.</li><li><a href="/book-consultation/">Consultation Request</a> — for financial, career, or leadership discussions.</li><li>General inquiry form — for messages that do not fit either category.</li></ul></div></div><div class="container" style="margin-top:3rem"><ContactForm/></div></section></BaseLayout>
