---
import{getCollection}from 'astro:content';import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/sections/PageHero.astro';import InsightCard from '@/components/cards/InsightCard.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';import{isVisible,sortByDateDesc}from '@/lib/content';const articles=(await getCollection('articles')).filter(isVisible).sort(sortByDateDesc);const categories=['Leadership','Career Development','Financial Education','Professional Growth'];
---
<BaseLayout title="Insights" description="Read Shane Perez’s approved leadership, career-development, financial-education, and professional-growth articles."><PageHero eyebrow="Insights" title="Ideas for leadership, careers, financial education, and professional growth." description="The initial collection includes structured article drafts whose factual sections require Shane’s interview, verification, and approval." breadcrumbs={[{label:'Home',href:'/'},{label:'Insights'}]}/><section class="section"><div class="container"><div class="cluster" aria-label="Article categories">{categories.map(category=><span class="badge">{category}</span>)}</div>{articles.length?<div class="grid grid--3" style="margin-top:2rem">{articles.map(article=><InsightCard title={article.data.title} description={article.data.description} category={article.data.category} status={article.data.status} href={`/insights/${article.id.replace(/\.md$/,'')}/`}/>)}</div>:<div style="margin-top:2rem"><DisclosureNotice title="No public articles yet"><p>Draft structures exist in the CMS but remain hidden from the normal production website until approved.</p></DisclosureNotice></div>}</div></section></BaseLayout>
