---
import {getCollection} from 'astro:content';import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/sections/PageHero.astro';import EventCard from '@/components/cards/EventCard.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';import CTASection from '@/components/sections/CTASection.astro';import{isVisible}from '@/lib/content';const events=(await getCollection('events')).filter(isVisible).sort((a,b)=>b.data.year-a.data.year);const achievements=(await getCollection('achievements')).filter(isVisible);
---
<BaseLayout title="Events, GAMA, and Achievements" description="Explore approved professional-development events, GAMA participation, conventions, awards, and team milestones from Shane Perez’s journey."><PageHero eyebrow="Events and Achievements" title="Continuous learning, professional development, and meaningful milestones." description="This visual archive will present approved convention, GAMA, award, team-event, and leadership-development content." breadcrumbs={[{label:'Home',href:'/'},{label:'Events, GAMA, and Achievements'}]}/><section class="section"><div class="container"><DisclosureNotice type="warning" title="All event and award claims require verification"><p>Names, dates, locations, award categories, qualifications, photographs, and company references must be confirmed before publication.</p></DisclosureNotice>{events.length?<div class="grid grid--3" style="margin-top:2rem">{events.map(({data})=><EventCard {...data} approved={data.status==='approved'}/>)}</div>:<div class="grid grid--3" style="margin-top:2rem"><EventCard title="GAMA LAMP Convention" location="Taiwan" year={2019} summary="[YEAR AND PARTICIPATION DETAILS REQUIRE VERIFICATION]"/><EventCard title="International Convention" location="Las Vegas" year={2023} summary="[EVENT DETAILS REQUIRE VERIFICATION]"/><EventCard title="International Convention" location="Denver" year={2024} summary="[EVENT DETAILS REQUIRE VERIFICATION]"/></div>}</div></section><section class="section section--muted"><div class="container"><h2>Awards and professional recognition</h2>{achievements.length?<div class="grid grid--3">{achievements.map(({data})=><article class="card"><span class="badge">{data.yearLabel}</span><h3>{data.title}</h3><p>{data.summary}</p>{data.verificationRequired&&<p class="help">[VERIFICATION REQUIRED]</p>}</article>)}</div>:<div class="card"><h3>Consistent GAMA Awardee</h3><p>[AWARD CATEGORY, YEARS, AND SOURCE DOCUMENTS REQUIRED]</p></div>}</div></section><CTASection title="See how professional development shapes Shane’s leadership." description="Continue through the leadership timeline or read the Builder of Builders philosophy." primaryLabel="View Leadership Journey" primaryHref="/leadership-journey/" secondaryLabel="Builder of Builders" secondaryHref="/builder-of-builders/"/></BaseLayout>
