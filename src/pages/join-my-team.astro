---
import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/sections/PageHero.astro';import CTASection from '@/components/sections/CTASection.astro';import AudienceCard from '@/components/cards/AudienceCard.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';import{audienceProfiles}from '@/data/site';import faqData from '@/data/faqs.json';const{careerFaqs}=faqData;
---
<BaseLayout title="Career Opportunities" description="Explore the Financial Advisor and leadership opportunity, candidate profiles, responsible expectations, and application process connected to Shane Perez’s professional community."><PageHero eyebrow="Join My Team" title="Explore a career with room to serve, learn, and lead." description="This page is designed for qualified professionals who want to understand the Financial Advisor or leadership opportunity before deciding whether to apply." breadcrumbs={[{label:'Home',href:'/'},{label:'Career Opportunities'}]}/><section class="section"><div class="container grid grid--2" style="align-items:start"><div class="prose"><h2>A career conversation, not a guarantee.</h2><p>A financial-services career may offer qualified professionals opportunities for client service, professional development, flexible work design, relationship building, mentorship, and leadership growth.</p><p>The final page will describe the approved role and recruitment process without overstating earnings, career independence, promotion, appointment, or business outcomes.</p></div><DisclosureNotice type="warning" title="Compliance review required"><p>Company-specific program names, role descriptions, qualifications, benefits, earnings language, and recruitment claims require Shane’s review and internal compliance approval before publication.</p></DisclosureNotice></div></section><section id="candidate-profile" class="section section--muted"><div class="container"><div class="prose"><span class="eyebrow">Candidate profile</span><h2>Who may be a strong fit?</h2><p class="lead">The following profiles reflect the project brief and remain subject to the authorized recruitment process.</p></div><div class="grid grid--3" style="margin-top:2rem">{audienceProfiles.map(profile=><AudienceCard {...profile}/>)}</div></div></section><section class="section"><div class="container grid grid--2"><article class="card card--accent"><h2>Potentially relevant strengths</h2><ul><li>Clear and responsible communication</li><li>Sales, client-service, banking, or relationship-management experience</li><li>Ability to build and maintain professional networks</li><li>Willingness to learn and accept feedback</li><li>Self-management and accountability</li><li>Interest in mentoring and leadership</li></ul></article><article class="card"><h2>What applicants should understand</h2><ul><li>The application is reviewed manually.</li><li>Applicants do not automatically receive an interview schedule.</li><li>Selection and appointment are not guaranteed.</li><li>Income, earnings, promotion, or career success are not guaranteed.</li><li>All final qualifications and terms come from the authorized process.</li></ul></article></div></section><section class="section section--warm"><div class="container"><div class="prose"><span class="eyebrow">Recruitment journey</span><h2>What happens after you explore the opportunity?</h2></div><ol class="grid grid--4" style="list-style:none;padding:0;margin-top:2rem;counter-reset:steps"><li class="card"><span class="badge">Step 1</span><h3>Learn</h3><p>Review Shane’s story, philosophy, candidate profiles, and team culture.</p></li><li class="card"><span class="badge">Step 2</span><h3>Reflect</h3><p>Consider your experience, goals, strengths, and readiness for the work.</p></li><li class="card"><span class="badge">Step 3</span><h3>Apply</h3><p>Complete the recruitment application and upload your résumé securely.</p></li><li class="card"><span class="badge">Step 4</span><h3>Review</h3><p>The authorized recruitment recipients assess the application and contact qualified applicants manually.</p></li></ol></div></section><section class="section"><div class="container prose"><span class="eyebrow">Frequently asked questions</span><h2>Before you apply</h2>{careerFaqs.map(item=><details class="card card--flat" style="margin-bottom:1rem"><summary><strong>{item.question}</strong></summary><p style="margin-top:1rem">{item.answer}</p></details>)}</div></section><CTASection title="Ready to be considered?" description="Complete the application only after reviewing the opportunity, privacy notice, and recruitment disclaimer." primaryLabel="Apply to Join the Team" primaryHref="/recruitment-application/" secondaryLabel="Request a Career Discussion" secondaryHref="/book-consultation/"/></BaseLayout>
