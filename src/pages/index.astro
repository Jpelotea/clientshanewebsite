---
import { getCollection } from 'astro:content';import BaseLayout from '@/layouts/BaseLayout.astro';import ButtonLink from '@/components/global/ButtonLink.astro';import MediaPlaceholder from '@/components/global/MediaPlaceholder.astro';import SectionHeading from '@/components/global/SectionHeading.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';import AudienceCard from '@/components/cards/AudienceCard.astro';import CredibilityCard from '@/components/cards/CredibilityCard.astro';import InsightCard from '@/components/cards/InsightCard.astro';import TestimonialCard from '@/components/cards/TestimonialCard.astro';import LeaderCard from '@/components/cards/LeaderCard.astro';import EventCard from '@/components/cards/EventCard.astro';import CTASection from '@/components/sections/CTASection.astro';import {site,credibility,audienceProfiles} from '@/data/site';import homepage from '@/data/homepage.json';import {isVisible,sortByDateDesc} from '@/lib/content';const articles=(await getCollection('articles')).filter(isVisible).sort(sortByDateDesc).slice(0,3);const testimonials=(await getCollection('testimonials')).filter(isVisible).slice(0,3);const leaders=(await getCollection('leaders')).filter(isVisible).slice(0,2);const events=(await getCollection('events')).filter(isVisible).sort((a,b)=>b.data.year-a.data.year).slice(0,3);
---
<BaseLayout title={site.name} description={site.defaultDescription}><section class="hero"><div class="container hero-grid"><div><span class="eyebrow">{homepage.heroEyebrow}</span><h1>{homepage.heroHeading}</h1><p class="lead">{homepage.heroCopy}</p><div class="hero-actions"><ButtonLink href="/join-my-team/" tracking="hero_explore_careers">Explore Career Opportunities</ButtonLink><ButtonLink href="/about-shane/" variant="secondary" tracking="hero_about">Learn About Shane</ButtonLink><ButtonLink href="/book-consultation/" variant="text" tracking="hero_consultation">Request a Consultation</ButtonLink></div></div><MediaPlaceholder label="[APPROVED PROFESSIONAL HERO PHOTO OF SHANE REQUIRED]" height="31rem"/></div></section><section class="section"><div class="container grid grid--2" style="align-items:center"><MediaPlaceholder label="[APPROVED PROFESSIONAL OR MENTORSHIP PHOTO REQUIRED]"/><div><span class="eyebrow">Meet Shane Perez</span><h2>{homepage.meetHeading}</h2><p>With more than 13 years of professional experience in client service and a financial-services journey that began in 2018, Shane has developed from Financial Advisor to Unit Head and Branch Head.</p><p>Her present focus is building professionals, mentoring leaders, strengthening community, and helping future organization builders develop the skills and confidence to lead others responsibly.</p><DisclosureNotice title="Verification note"><p>Biography wording, dates, and credentials require Shane’s final confirmation before public launch.</p></DisclosureNotice><ButtonLink href="/about-shane/" variant="text">Read Shane’s Story</ButtonLink></div></div></section><section class="section section--muted"><div class="container grid grid--2" style="align-items:center"><div><span class="eyebrow">Builder of Builders</span><h2>{homepage.builderHeading}</h2><p class="lead">Sustainable growth becomes possible when leaders develop other leaders.</p><p>Shane’s philosophy goes beyond building a sales organization. It centers on creating an environment where professionals learn, lead, mentor, and eventually build opportunities for other people.</p><ButtonLink href="/builder-of-builders/">Discover the Builder of Builders Philosophy</ButtonLink></div><div class="card card--accent"><h3>What the philosophy emphasizes</h3><ul><li>Personal and professional development</li><li>Mentorship with standards and support</li><li>Leadership duplication</li><li>Responsible independence</li><li>Community and long-term organization building</li></ul></div></div></section><section class="section"><div class="container"><SectionHeading eyebrow="Professional credibility" title="A journey shaped by service, learning, and leadership." description="The following details are included as review content and must be verified before public publication."/><div class="grid grid--4" style="margin-top:2rem">{credibility.map(item=><CredibilityCard {...item}/>)}</div><div class="cluster" style="margin-top:2rem"><ButtonLink href="/leadership-journey/" variant="secondary">View Shane’s Leadership Journey</ButtonLink></div></div></section><section class="section section--dark"><div class="container grid grid--2" style="align-items:center"><div><span class="eyebrow" style="color:#f0d7a6">Career opportunity</span><h2>{homepage.careerHeading}</h2><p class="lead">For the right professional, a career in financial services may offer a path toward service, independence, professional development, mentorship, and leadership.</p><p>The website presents the opportunity responsibly, without guaranteeing selection, appointment, income, promotion, or career success.</p><ButtonLink href="/join-my-team/" variant="light" tracking="home_career">Explore Career Opportunities</ButtonLink></div><MediaPlaceholder label="[APPROVED TEAM OR CAREER-DEVELOPMENT PHOTO REQUIRED]"/></div></section><section class="section section--warm"><div class="container"><SectionHeading eyebrow="Who the opportunity is for" title="Different experience. Shared potential to grow." description="Candidate criteria remain subject to Shane’s review and the authorized recruitment process."/><div class="grid grid--3" style="margin-top:2rem">{audienceProfiles.map(profile=><AudienceCard {...profile}/>)}</div><div class="cluster" style="margin-top:2rem"><ButtonLink href="/join-my-team/#candidate-profile" variant="secondary">Check the Candidate Profile</ButtonLink></div></div></section><section class="section"><div class="container"><SectionHeading eyebrow="Leadership community" title="Growth is stronger when it is shared." description="Team culture, mentorship, promotions, and leadership stories can demonstrate how people develop within Shane’s community."/>{leaders.length?<div class="grid grid--2" style="margin-top:2rem">{leaders.map(({data})=><LeaderCard {...data} approved={data.status==='approved'}/>)}</div>:<div style="margin-top:2rem"><DisclosureNotice title="Leadership profiles pending"><p>Two profiles are planned. Names, roles, photos, and summaries require the leaders’ confirmation and permission.</p></DisclosureNotice></div>}<div class="cluster" style="margin-top:2rem"><ButtonLink href="/team-leadership-community/">Meet the Leadership Community</ButtonLink></div></div></section><section class="section section--muted"><div class="container"><SectionHeading eyebrow="Success stories" title="Real experiences, shared responsibly." description="The launch plan includes Financial Advisor, leadership, team, and permitted client testimonials."/>{testimonials.length?<div class="grid grid--3" style="margin-top:2rem">{testimonials.map(({data})=><TestimonialCard {...data} approved={data.status==='approved'&&data.permissionConfirmed}/>)}</div>:<div style="margin-top:2rem"><DisclosureNotice title="Testimonials pending approval"><p>Two Financial Advisor testimonials, one Unit Head or Senior Unit Head testimonial, two team success stories, and two client testimonials are planned. They remain hidden until permission and final approval are documented.</p></DisclosureNotice></div>}<div class="cluster" style="margin-top:2rem"><ButtonLink href="/success-stories/" variant="secondary">View Success Stories</ButtonLink></div></div></section><section class="section"><div class="container"><SectionHeading eyebrow="Events and achievements" title="Continuous learning and professional development." description="The visual collection will feature approved GAMA, convention, award, team-event, and professional-development materials."/>{events.length?<div class="grid grid--3" style="margin-top:2rem">{events.map(({data})=><EventCard {...data} approved={data.status==='approved'}/>)}</div>:<div style="margin-top:2rem"><DisclosureNotice title="Event content pending"><p>Approved photos and verified details are required for Taiwan, Las Vegas 2023, Denver 2024, awards, and team events.</p></DisclosureNotice></div>}<div class="cluster" style="margin-top:2rem"><ButtonLink href="/events-achievements/" variant="text">View Events and Achievements</ButtonLink></div></div></section><section class="section section--warm"><div class="container"><SectionHeading eyebrow="Latest insights" title="Leadership, careers, financial education, and professional growth." description="Initial articles are structured drafts. Factual sections remain clearly marked until Shane’s interview and approval are complete."/>{articles.length?<div class="grid grid--3" style="margin-top:2rem">{articles.map(article=><InsightCard title={article.data.title} description={article.data.description} category={article.data.category} status={article.data.status} href={`/insights/${article.id.replace(/\.md$/,'')}/`}/>)}</div>:<div style="margin-top:2rem"><DisclosureNotice title="Articles awaiting approval"><p>Draft article structures are included in the CMS and hidden from public production until approved.</p></DisclosureNotice></div>}<div class="cluster" style="margin-top:2rem"><ButtonLink href="/insights/">Explore All Insights</ButtonLink></div></div></section><section class="section"><div class="container grid grid--2" style="align-items:center"><div><span class="eyebrow">Career-fit resource</span><h2>Is a Financial Advisor Career Right for You?</h2><p class="lead">A practical career-fit guide for young and experienced professionals.</p><p>The initial downloadable file is clearly marked as a review draft. It must be replaced or approved before public promotion.</p><ButtonLink href="/documents/financial-advisor-career-fit-guide-draft.pdf" tracking="career_guide_download">Download Draft Guide</ButtonLink></div><MediaPlaceholder label="[APPROVED CAREER GUIDE COVER REQUIRED]"/></div></section><section class="section section--muted"><div class="container grid grid--2" style="align-items:center"><div><span class="eyebrow">Start a conversation</span><h2>Choose the discussion that fits your goal.</h2><p>Request a financial consultation, career opportunity discussion, or leadership opportunity discussion. Requested dates are preferences and require manual confirmation.</p></div><div class="cluster" style="justify-content:flex-end"><ButtonLink href="/book-consultation/" tracking="home_consultation">Request a Consultation</ButtonLink></div></div></section><CTASection title={homepage.finalCtaHeading} description="Review the career opportunity and submit an application when you are ready to be considered through the authorized recruitment process." primaryLabel="Apply to Join the Team" primaryHref="/recruitment-application/" secondaryLabel="Send a Message" secondaryHref="/contact/"/></BaseLayout>
