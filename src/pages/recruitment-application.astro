---
import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/sections/PageHero.astro';import RecruitmentForm from '@/components/forms/RecruitmentForm.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';
---
<BaseLayout title="Recruitment Application" description="Submit a secure application for review after exploring Shane Perez’s Financial Advisor or leadership opportunity." noindex={false}><PageHero eyebrow="Recruitment Application" title="Submit your application for review." description="The authorized recruitment recipients will review your information manually. Submission does not create an automatic interview or guarantee any outcome." breadcrumbs={[{label:'Home',href:'/'},{label:'Career Opportunities',href:'/join-my-team/'},{label:'Recruitment Application'}]}/><section class="section"><div class="container"><div class="grid grid--2" style="align-items:start"><div><DisclosureNotice type="warning" title="Before submitting"><p>Submitting an application does not guarantee selection, employment, appointment, admission to a program, income, earnings, promotion, or career success.</p></DisclosureNotice><h2 style="margin-top:2rem">What you will need</h2><ul><li>Accurate contact and professional information</li><li>Relevant education and experience details</li><li>A brief explanation of your interest and strengths</li><li>Your preferred interview availability</li><li>A PDF, DOC, or DOCX résumé no larger than 4 MB</li></ul><p class="help">Résumé uploads remain disabled until the approved secure storage, retention, recipient, and deletion settings are configured.</p></div><div class="card"><h2>Privacy at a glance</h2><p>Your information will be used only to review and respond to the application, subject to the final approved Privacy Policy. Résumés must be stored privately and shared with authorized recipients through time-limited protected links.</p><p><a href="/privacy-policy/">Read the Privacy Policy draft</a></p></div></div><div style="margin-top:3rem"><RecruitmentForm/></div></div></section></BaseLayout>
