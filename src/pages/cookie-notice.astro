import BaseLayout from '@/layouts/BaseLayout.astro';import PageHero from '@/components/sections/PageHero.astro';import DisclosureNotice from '@/components/global/DisclosureNotice.astro';
---
<BaseLayout title="Cookie Notice" description="Review the draft cookie and consent information for Shane Perez’s personal professional website." noindex={true}><PageHero eyebrow="Legal Review Draft" title="Cookie Notice" description="This notice describes the planned consent controls and requires legal and compliance approval before public launch." breadcrumbs={[{label:'Home',href:'/'},{label:'Cookie Notice'}]}/><section class="section"><div class="container prose"><DisclosureNotice type="warning" title="Draft for review"><p>[COMPLIANCE-APPROVED COOKIE NOTICE REQUIRED]</p></DisclosureNotice><h2>Essential storage</h2><p>The website may store a privacy-choice record and use security-related technologies necessary for forms and website protection.</p><h2>Analytics</h2><p>Google Analytics is planned to load only after analytics consent and only after a real measurement ID is configured.</p><h2>Marketing measurement</h2><p>Meta Pixel is planned to load only after marketing consent and only after an approved real pixel ID is configured.</p><h2>Changing a choice</h2><p>Visitors can reopen Cookie settings from the footer. The approved final implementation must explain any limitations related to already transmitted information.</p><h2>Provider details and retention</h2><p>[FINAL PROVIDER NAMES, COOKIE TABLE, PURPOSES, EXPIRY PERIODS, AND INTERNATIONAL-TRANSFER INFORMATION REQUIRED]</p></div></section></BaseLayout>
