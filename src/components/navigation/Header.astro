---
import { site } from '@/data/site'; const path=Astro.url.pathname; const isCurrent=(href:string)=>href==='/'?path==='/':path.startsWith(href);
---
<header class="site-header"><div class="container navbar"><a class="brand" href="/" aria-label="Shane Perez home"><strong>{site.name}</strong><span>{site.tagline}</span></a><nav class="nav-links" aria-label="Primary navigation">{site.navigation.map(item=><a href={item.href} aria-current={isCurrent(item.href)?'page':undefined}>{item.label}</a>)}</nav><a class="button button--primary desktop-cta" href="/recruitment-application/" data-track="header_apply">Apply to Join</a><button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation"><span class="mobile-toggle-label">Menu</span></button></div><nav id="mobile-navigation" class="container mobile-panel" aria-label="Mobile navigation" aria-hidden="true">{site.navigation.map(item=><a href={item.href} aria-current={isCurrent(item.href)?'page':undefined}>{item.label}</a>)}<a href="/recruitment-application/">Apply to Join</a><a href="/book-consultation/">Request a Consultation</a></nav></header>
<script>const toggle=document.querySelector<HTMLButtonElement>('.mobile-toggle');const panel=document.querySelector<HTMLElement>('#mobile-navigation');if(toggle&&panel){const label=toggle.querySelector<HTMLElement>('.mobile-toggle-label');const close=()=>{toggle.setAttribute('aria-expanded','false');panel.setAttribute('aria-hidden','true');if(label)label.textContent='Menu';};toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));panel.setAttribute('aria-hidden',String(open));if(label)label.textContent=open?'Menu':'Close menu';if(!open)panel.querySelector<HTMLElement>('a')?.focus();});document.addEventListener('keydown',event=>{if(event.key==='Escape'){close();toggle.focus();}});panel.querySelectorAll('a').forEach(link=>link.addEventListener('click',close));}</script>
